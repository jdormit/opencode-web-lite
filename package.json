{
  "name": "opencode-web-lite",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "start": "NODE_ENV=production bun run server.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:server": "bun run build && bun test tests/server",
    "test:browser": "playwright test",
    "check": "bun run typecheck && bun run test && bun run build && bun test tests/server"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.18.4",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "valibot": "1.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
